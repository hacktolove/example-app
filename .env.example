APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

APP_API_KEY=

# One database per VAS service. See config/vasws.php for the serviceid -> connection map.
DB_NEWS_CONNECTION=pgsql
DB_NEWS_HOST=127.0.0.1
DB_NEWS_PORT=5432
DB_NEWS_DATABASE=service_1
DB_NEWS_USERNAME=peter
DB_NEWS_PASSWORD=password

DB_SPORT_CONNECTION=pgsql
DB_SPORT_HOST=127.0.0.1
DB_SPORT_PORT=5432
DB_SPORT_DATABASE=service_2
DB_SPORT_USERNAME=peter
DB_SPORT_PASSWORD=password

VAS_WS_USERNAME=
VAS_WS_PASSWORD=

# Where IVR prompt audio is written for the telephony system to read.
# Files are laid out as {IVR_AUDIO_ROOT}/{service package}/NNN-name.wav, ordered
# by the numeric filename prefix. The web user needs write access here and the
# telephony user needs read access.
# Leave unset to use storage/app/ivr.
# IVR_AUDIO_ROOT=/srv/ivr/prompts

WAVE_BASE_URL=
WAVE_USERNAME=
WAVE_PASSWORD=
WAVE_TIMEOUT=10
# WAVE_ORIGIN_HOST_NAME=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
